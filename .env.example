# ---- 开发 ----
# miningqwqmusic BFF 的地址，npm run dev 时 /api 会代理过去
BFF_TARGET=http://127.0.0.1:3000

# ---- 构建（会打进前端代码，不要放密钥）----
# BFF 地址；留空 = 与前端同源（推荐：把 dist/ 和 BFF 放在同一个域名下）
VITE_API_BASE=
# 站点名
VITE_SITE_NAME=唱片行
# 默认音质：standard / higher / exhigh / lossless / hires
VITE_DEFAULT_QUALITY=exhigh
# 封面缩略参数（网易云图床的 ?param=WxH），换了图床可设为 off
VITE_IMAGE_RESIZE=on
# 用唱片行风格的生成封面替换上游的榜单封面，设为 off 则保留原图
VITE_REPLACE_TOPLIST_COVERS=on
